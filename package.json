{
  "name": "supabase-react-template",
  "description": "Gemelo digital agrícola para monitoreo y seguimiento del nopal",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:windows": "npm run build && electron-builder --win nsis --publish never",
    "start:desktop": "electron .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@supabase/supabase-js": "^2.47.3",
    "lucide-react": "^0.468.0",
    "pino": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@elementor/sandbox-dev-scripts-injector": "latest",
    "@eslint/js": "^9.16.0",
    "@sticklightapp/sandbox-logger": "0.0.12",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.12.0",
    "supabase": "^2.58.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.dtwin.desktop",
    "productName": "D.Twin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publish": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "D.Twin"
    }
  }
}
